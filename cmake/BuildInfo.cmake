# Writes the commit the plugins are built from to OUTPUT, as a C++ header.
# Runs at every build, and rewrites the header only when the commit changes,
# so a new commit is picked up without reconfiguring. "-dirty" marks a build
# with uncommitted changes to tracked files; "unknown" means no git checkout.

execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse --short HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
if(failed OR commit STREQUAL "")
    set(commit "unknown")
else()
    execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND commit "-dirty")
    endif()
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT [[
// Generated by cmake/BuildInfo.cmake at build time. Do not edit.
#pragma once

namespace ak4522demo::build {
inline constexpr const char* commit = "@commit@";
} // namespace ak4522demo::build
]] @ONLY)
